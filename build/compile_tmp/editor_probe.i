    shear[0] = Vector3DotProduct(matColumns[0], matColumns[1]);
    matColumns[1] = Vector3Subtract(matColumns[1], Vector3Scale(matColumns[0], shear[0]));


    scl.y = Vector3Length(matColumns[1]);
