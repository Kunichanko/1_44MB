    Matrix rotationMatrix = { matColumns[0].x, matColumns[0].y, matColumns[0].z, 0,
                             matColumns[1].x, matColumns[1].y, matColumns[1].z, 0,
                             matColumns[2].x, matColumns[2].y, matColumns[2].z, 0,
